    private static string PeptideNote(PeptidePlan plan)
    {
        var info = PeptideLibrary.Lookup(plan.PeptideName);
        if (info is not null)
        {
            return info.Note;
        }

        return string.IsNullOrWhiteSpace(plan.PeptideName)
            ? "Custom peptide - enter your own dose phases below."
            : "Not in the library - enter dose phases below.";
    }

    private static string TierCaption(PeptidePlan plan, int index)
    {
        var interval = PlannerCalculator.IntervalDays(plan);
        var startDate = Dates.ParseStartDate(plan.StartDate);
        var scheduleCursor = 0;
        var doseCursor = 0;

        for (var i = 0; i <= index && i < plan.Tiers.Count; i++)
        {
            var tier = plan.Tiers[i];
            var scheduleCount = PlannerCalculator.TierScheduleCount(tier, plan);
            var doseCount = PlannerCalculator.TierDoseCount(tier, plan);
            if (i != index)
            {
                scheduleCursor += scheduleCount;
                doseCursor += doseCount;
                continue;
            }

            var startDay = (int)Math.Round(scheduleCursor * interval) + 1;
            scheduleCursor += scheduleCount;
            var endDay = (int)Math.Round(scheduleCursor * interval);
            if (tier.Type == TierTypes.Off)
            {
                var offLabel = plan.ScheduleMode == ScheduleModes.Interval
                    ? $"{scheduleCount} skipped {(scheduleCount == 1 ? "dose" : "doses")}"
                    : $"{Formatters.Number(tier.Weeks, 1)} {(Math.Abs(tier.Weeks - 1) < 0.001 ? "week" : "weeks")} off";
                return startDay == endDay ? $"Day {startDay} · {offLabel}" : $"Days {startDay} - {endDay} · {offLabel}";
            }

            var startDose = doseCursor + 1;
            var endDose = doseCursor + doseCount;
            var lastShotDate = Dates.AddDays(startDate, Math.Round((scheduleCursor - 1) * interval));
            var range = startDay == endDay ? $"Day {startDay}" : $"Days {startDay} - {endDay}";
            return $"{range} · {doseCount} {(doseCount == 1 ? "Dose" : "Doses")} · {Mg(doseCount * tier.DoseMg)} mg total · ends {Formatters.Date(lastShotDate)}";
        }

        return "";
    }

    private static string RecommendedSummary(PeptidePlan plan, ComputedPlan result)
    {
        if (result.Empty)
        {
            return "Add at least one dose phase to build a plan.";
        }

        if (result.Recommended is null)
        {
            return "No water amount keeps this plan within a 100-unit syringe. Lower the dose or raise the vial amount.";
        }

        return $"Add {Formatters.Number(result.Recommended.Ml, 1)} mL BAC water to {(string.IsNullOrWhiteSpace(plan.PeptideName) ? "the vial" : plan.PeptideName)} for {PlannerCalculator.SummarizeDoses(result.Doses, Mg)}.";
    }

    private static string RecommendedPerWeek(PeptidePlan plan, ComputedPlan result)
    {
        if (result.Recommended is null || result.Doses.Count == 0)
        {
            return "";
        }

        var dpw = PlannerCalculator.DosesPerWeek(plan);
        var distinctDoses = result.Doses.Select(dose => dose.DoseMg).Distinct().Order().ToList();
        var mgPerWeek = distinctDoses.Select(dose => dose * dpw);
        var unitsPerWeek = distinctDoses.Select(dose => dose / result.Recommended.Concentration * 100 * dpw);
        return $"~ {Formatters.Range(mgPerWeek, 3)} mg / week · {Formatters.Range(unitsPerWeek, 0)} units / week ({Formatters.Number(dpw, 1)}x weekly)";
    }

    private static string ScheduleSummary(PeptidePlan plan, ComputedPlan result)
    {
        if (result.Empty)
        {
            return "No schedule to preview yet.";
        }

        if (result.Recommended is null)
        {
            return "No schedule fits a 100-unit syringe yet.";
        }

        var planWeeks = result.PlanDurationDays / 7.0;
        var vialsLabel = VialsLabel(result.VialsNeeded);
        return $"{PlannerCalculator.ScheduleLabel(plan)}; {result.Doses.Count} shots over ~{Formatters.Number(planWeeks, 0)} weeks. Needs {vialsLabel} ({Mg(result.TotalMg)} mg total).";
    }

    private static string CleanupMessage(PeptidePlan plan, ComputedPlan result)
    {
        if (plan.FlexibleDose && result.CleanupSuggestions.Count > 0)
        {
            var suggestion = result.CleanupSuggestions[0];
            var shotRange = suggestion.ShotStartIndex == suggestion.ShotEndIndex
                ? $"shot {suggestion.ShotStartIndex + 1}"
                : $"shots {suggestion.ShotStartIndex + 1}-{suggestion.ShotEndIndex + 1}";
            var more = result.CleanupSuggestions.Count > 1 ? $" {result.CleanupSuggestions.Count - 1} more vial cleanup adjustments applied." : "";
            return $"Cleaned vial {suggestion.VialNumber}: increased {shotRange} by {Formatters.Number(suggestion.AdjustmentPct, 1)}% (+{Mg(suggestion.AddedMg)} mg total).{more}";
        }

        return plan.FlexibleDose
            ? $"No cleanup adjustment found within {Formatters.Number(plan.FlexibleDosePct, 0)}%."
            : "Flexible dose is off; vial cleanup suggestions are hidden.";
    }

    private static string VialsLabel(int count) => count == 1 ? "1 vial" : $"{count} vials";

    private static string Mg(double value) => Formatters.Number(value, 3);

    private List<ScheduleEvent> ManualBacEvents()
    {
        var computedHasShots = ComputedPlans.Any(entry => entry.Result.Shots.Count > 0);
        var startNumber = computedHasShots ? 2 : 1;
        return Store.Prefs.ManualBacOpenDates.SelectMany((date, index) =>
        {
            var opened = Dates.ParseStartDate(date);
            var bacNumber = startNumber + index;
            return new[]
            {
                new ScheduleEvent(opened, "bac", "opened", $"BAC Water {bacNumber} Opened", ""),
                new ScheduleEvent(Dates.AddDays(opened, Store.Prefs.BacWindowDays), "bac", "expires", $"BAC Water {bacNumber} Expiring", "")
            };
        }).ToList();
    }

    private static List<ScheduleDay> BuildShotDays(IEnumerable<ShotEntry> shots, bool showTag, IEnumerable<ScheduleEvent>? events = null)
    {
        var days = new Dictionary<string, ScheduleDay>();
        void Add(DateTime date, ScheduleItem item)
        {
            var key = Dates.DateInputValue(date);
            if (!days.TryGetValue(key, out var day))
            {
                day = new ScheduleDay(date);
                days[key] = day;
            }

            day.Items.Add(item);
        }

        foreach (var item in events ?? [])
        {
            Add(item.Date, new ScheduleItem("event", item.Tone, item.Label, item.Value, 0, null));
        }

        foreach (var shot in shots)
        {
            if (!showTag && shot.BacOpened && shot.BacExpires is not null)
            {
                Add(shot.Date, new ScheduleItem("event", "bac", "BAC Water 1 Opened", "", 0, null));
                Add(shot.BacExpires.Value, new ScheduleItem("event", "bac", "BAC Water 1 Expiring", "", 0, null));
            }
            if (shot.OpensVial)
            {
                var peptide = string.IsNullOrWhiteSpace(shot.PeptideName) ? "" : $"{shot.PeptideName} ";
                Add(shot.Date, new ScheduleItem("event", "open", $"Open {peptide}vial {shot.VialNumber}", "", 0, null));
            }

            var meta = showTag
                ? $"{(string.IsNullOrWhiteSpace(shot.PeptideName) ? "Untitled" : shot.PeptideName)} · {Mg(shot.DoseMg)} mg"
                : $"{Mg(shot.DoseMg)} mg · phase {shot.TierIndex + 1}";
            Add(shot.Date, new ScheduleItem("shot", "", meta, "", shot.Index, shot.Units));

            if (shot.EndsVial is not null)
            {
                var peptide = string.IsNullOrWhiteSpace(shot.PeptideName) ? "" : $"{shot.PeptideName} ";
                Add(shot.Date, new ScheduleItem("event", "end", $"End {peptide}vial {shot.EndsVial.VialNumber}", $"{Mg(shot.EndsVial.UnusedMg)} mg unused", 0, null));
            }
        }

        return days.Values.OrderBy(day => day.Date).ToList();
    }

    private RenderFragment RenderShotDays(List<ScheduleDay> days, bool showTag = false) => @<div class="schedule-list">
        @if (days.Count == 0)
        {
            <p class="empty-hint">No scheduled injections yet.</p>
        }
        @foreach (var day in days)
        {
            <div class="schedule-day">
                <div class="shot-date">@Formatters.Date(day.Date)</div>
                <div class="schedule-day-items">
                    @foreach (var item in day.Items)
                    {
                        if (item.Type == "shot")
                        {
                            <div class="schedule-shot @(showTag ? "schedule-shot--named" : "")">
                                @if (!showTag)
                                {
                                    <span class="shot-number">@(item.Index + 1)</span>
                                }
                                <div class="shot-meta">@item.Label</div>
                                <span class="pill">@(item.Units is null ? "-" : $"{Formatters.Number(item.Units.Value, 1)} units")</span>
                            </div>
                        }
                        else
                        {
                            <div class="schedule-event @item.Tone">
                                <span>@item.Label</span>
                                @if (!string.IsNullOrWhiteSpace(item.Value))
                                {
                                    <strong>@item.Value</strong>
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        }
    </div>;

    private sealed record ScheduleEvent(DateTime Date, string Tone, string Kind, string Label, string Value);

    private sealed record ScheduleDay(DateTime Date)
    {
        public List<ScheduleItem> Items { get; } = [];
    }

    private sealed record ScheduleItem(string Type, string Tone, string Label, string Value, int Index, double? Units);
}
